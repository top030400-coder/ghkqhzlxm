<!doctype html><meta charset="utf-8"><title>fx measure</title>
<body style="background:#111;color:#ddd;font:13px monospace">
<canvas id="cv" width="720" height="150"></canvas>
<pre id="out">running…</pre>
<script src="light_fx.js"></script>
<script>
var W=720,H=150;
var cv=document.getElementById('cv'), ctx=cv.getContext('2d',{willReadFrequently:true});

// ---- 합성 배경(하단 배너 상정): 그라데이션 + 소품 + 구운 글자 + 인물 실루엣 ----
function drawBG(c){
  var g1=c.createLinearGradient(0,0,W,H);
  g1.addColorStop(0,'#171a2e'); g1.addColorStop(0.5,'#243055'); g1.addColorStop(1,'#3a2b4d');
  c.fillStyle=g1; c.fillRect(0,0,W,H);
  for(var i=0;i<40;i++){ c.fillStyle='rgba(255,255,255,'+(0.03+0.05*((i*37)%7)/7)+')';
    c.fillRect((i*97)%W,(i*53)%H,2,2); }
  c.fillStyle='rgba(255,255,255,0.06)'; c.fillRect(0,H-16,W,16);
  c.font='800 63px sans-serif'; c.textBaseline='middle';
  c.fillStyle='#f2e9d8'; c.fillText('MOONLIT STUDIO',216,84);
  c.fillStyle='#0d0f1c';
  c.beginPath(); c.ellipse(465+107,6+36,43,29,0,0,6.2832); c.fill();
  c.beginPath(); c.moveTo(465+30,150); c.quadraticCurveTo(465+107,6+43,465+185,150); c.closePath(); c.fill();
}
window.BANNER_TEXT='MOONLIT STUDIO';

// ---- 128색 팔레트 근사: 채널 12단계 양자화 후 비교 ----
var Q=12;
function snap(d){ var n=d.length,o=new Uint8Array(n);
  for(var i=0;i<n;i+=4){ o[i]=Math.round(d[i]/Q); o[i+1]=Math.round(d[i+1]/Q); o[i+2]=Math.round(d[i+2]/Q); }
  return o; }
function diffCount(a,b){ var c=0; for(var i=0;i<a.length;i+=4){ if(a[i]!==b[i]||a[i+1]!==b[i+1]||a[i+2]!==b[i+2]) c++; } return c; }

function run(name,fn,frames){
  var prev=null, base=null, tot=0, peak=0, per=[];
  for(var f=0;f<frames;f++){
    ctx.setTransform(1,0,0,1,0,0); ctx.globalAlpha=1; ctx.globalCompositeOperation='source-over';
    ctx.shadowBlur=0; ctx.shadowColor='rgba(0,0,0,0)';
    drawBG(ctx);
    ctx.save(); fn(ctx, f/frames, W, H); ctx.restore();
    var q=snap(ctx.getImageData(0,0,W,H).data);
    if(prev){ var d=diffCount(prev,q); tot+=d; peak=Math.max(peak,d); per.push(d); }
    else base=q;
    prev=q;
  }
  // 루프 이음새: 마지막 → 첫 프레임 델타도 포함
  var seam=diffCount(prev,base); tot+=seam; peak=Math.max(peak,seam);
  var px=W*H;
  var kb=(29*1024 + tot*0.35)/1024;
  return name+'\n  frames='+frames+'  총변화px='+tot+'  프레임당평균='+Math.round(tot/frames)
    +' ('+(100*tot/frames/px).toFixed(2)+'%)  피크='+peak+' ('+(100*peak/px).toFixed(2)+'%)'
    +'  이음새델타='+seam
    +'\n  추정용량 ≈ '+kb.toFixed(0)+'KB (베이스29KB + 0.35B/px)'
    +'\n  프레임별: '+per.join(',')+'\n';
}

var out=[];
out.push(run('1 텍스트결 스윕', FX.textGrainSweep, 25));
out.push(run('2 테두리 러너',   FX.borderRunner,   30));
out.push(run('3 대각 섬광',     FX.diagonalFlash,  20));
out.push(run('4 코너 브리딩',   FX.cornerBreath,   20));
out.push(run('5 네온 통전',     FX.neonCurrent,    25));
out.push(run('6 인물 림라이트', FX.rimLightPass,   25));
document.getElementById('out').textContent=out.join('\n');
</script>
