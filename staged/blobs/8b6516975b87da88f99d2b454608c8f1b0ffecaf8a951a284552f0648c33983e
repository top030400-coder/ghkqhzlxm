/* ============================================================
   Photobook Kit — 완성본(책 뷰) 셸 CSS
   펼친 책 스테이지 · 낱장 플립 · 하단 컨트롤 바 · 인쇄
   ============================================================ */
html,body{height:100%}
body{background:var(--mat);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow:hidden;
  opacity:0;transition:opacity .45s ease}
body.ready{opacity:1}
@media (prefers-reduced-motion:reduce){body{opacity:1;transition:none}}

#stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;perspective:3000px}
#book{
  position:relative;height:min(86svh,58vw);aspect-ratio:3/2;
  transform-style:preserve-3d;
  transition:transform .85s cubic-bezier(.4,.1,.3,1);
}
#book.single{transform:translateX(-25%)}
#book.singleR{transform:translateX(25%)}
@media (prefers-reduced-motion:reduce){#book{transition:none}}
.page{position:absolute;top:0;width:50%;height:100%}
.pageL{left:0}
.pageR{left:50%}
#store{display:none}

.page .sheet{box-shadow:0 26px 60px rgba(30,40,36,.20),0 5px 14px rgba(30,40,36,.10)}
.pageL .sheet{border-radius:6px 0 0 6px}
.pageR .sheet{border-radius:0 6px 6px 0}
.pageL .sheet::after,.leaf .face.fL::after{content:"";position:absolute;inset:0;z-index:60;pointer-events:none;
  background:linear-gradient(to left,rgba(20,24,22,.16),rgba(20,24,22,.02) 9%,transparent 14%)}
.pageR .sheet::after,.leaf .face.fR::after{content:"";position:absolute;inset:0;z-index:60;pointer-events:none;
  background:linear-gradient(to right,rgba(20,24,22,.16),rgba(20,24,22,.02) 9%,transparent 14%)}

.leaf{position:absolute;top:0;width:50%;height:100%;transform-style:preserve-3d;z-index:5}
.leaf .face{position:absolute;inset:0;backface-visibility:hidden;overflow:hidden;background:var(--paper)}
.leaf .face.rev{transform:rotateY(180deg)}
.leaf .face .sheet{box-shadow:none}
.leaf.turnNext{left:50%;transform-origin:left center;animation:turnL .85s cubic-bezier(.42,.08,.36,1) forwards}
.leaf.turnPrev{left:0;transform-origin:right center;animation:turnR .85s cubic-bezier(.42,.08,.36,1) forwards}
@keyframes turnL{from{transform:rotateY(0)}to{transform:rotateY(-180deg)}}
@keyframes turnR{from{transform:rotateY(0)}to{transform:rotateY(180deg)}}

/* ---------- 컨트롤 바(이전 · 재생 · 다음 · 쪽수) ---------- */
.ctrl{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:10;
  display:flex;align-items:center;gap:10px;padding:7px 18px 7px 10px;border-radius:999px;
  background:rgba(250,249,246,.88);backdrop-filter:blur(8px);
  box-shadow:0 4px 16px rgba(30,40,36,.16)}
.navbtn{width:34px;height:34px;border-radius:50%;border:none;cursor:pointer;
  background:transparent;
  font-family:var(--serif);font-size:22px;line-height:1;color:#2c332f;
  display:flex;align-items:center;justify-content:center;padding-bottom:3px;
  transition:background .18s ease,transform .12s ease}
.navbtn:hover{background:rgba(30,40,36,.08)}
.navbtn:active{transform:scale(.92)}
.playbtn{width:34px;height:34px;border-radius:50%;border:none;cursor:pointer;
  background:#151515;color:#fff;font-size:11px;line-height:1;
  display:flex;align-items:center;justify-content:center;padding-left:2px;
  transition:background .18s ease}
.playbtn.on{background:var(--acc1);padding-left:0}
.playbtn:hover{background:var(--acc1)}
.count{font-family:var(--serif);font-size:11px;letter-spacing:.22em;color:#4c534f;margin-left:4px}

/* ---------- 첫 조작 힌트 ---------- */
.firsttip{position:fixed;left:50%;bottom:74px;transform:translate(-50%,10px);
  background:rgba(24,26,25,.82);color:#f4f3ec;font-size:13px;letter-spacing:.01em;
  padding:9px 16px;border-radius:999px;white-space:nowrap;pointer-events:none;
  opacity:0;transition:opacity .45s ease,transform .45s ease;z-index:50;
  box-shadow:0 6px 22px rgba(0,0,0,.25)}
.firsttip b{font-weight:800}
.firsttip.in{opacity:1;transform:translate(-50%,0)}
.firsttip.out{opacity:0;transform:translate(-50%,10px)}
@media (max-width:560px){.firsttip{font-size:11.5px;padding:8px 12px;bottom:64px}}
@media (prefers-reduced-motion: reduce){
  .firsttip{transition:none}
}

/* ---------- 캡처 검증용 ---------- */
html.shot .ctrl{display:none}
html.flat #stage,html.flat .ctrl{display:none}
html.flat body{overflow:auto}
html.flat #store{display:block}
html.flat #store .sheet{width:760px;aspect-ratio:3/4;height:auto;margin:24px auto;border-radius:4px}

/* ---------- 인쇄(PDF 저장) ---------- */
@page{size:210mm 280mm;margin:0}
@media print{
  body{background:#fff;overflow:visible}
  .ctrl,#stage{display:none}
  #store{display:block}
  #store .sheet{width:210mm;height:280mm;aspect-ratio:auto;border-radius:0;box-shadow:none;
    transform:none !important;animation:none !important;page-break-after:always;break-after:page}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
