<!doctype html><meta charset="utf-8"><title>rim cutout measure</title>
<body style="background:#0b0b0f;color:#ddd;font:12px/1.5 monospace;margin:0;padding:6px">
<pre id="out">…</pre>
<div id="v"></div>
<script src="gifenc.js"></script>
<script src="rim_assets.js"></script>
<script>
const GE=window.gifenc;
let BG=null,SUBJ=null,CUT=null;
function loadImg(u){ return new Promise((ok,no)=>{ const i=new Image(); i.onload=()=>ok(i); i.onerror=no; i.src=u; }); }

/* 누끼(투명 배경) 인물 합성 — 머리+머리카락 갈래+어깨, 잔머리 몇 가닥으로 윤곽 복잡도 재현 */
function makeCut(){
  const m=document.createElement('canvas'); m.width=420;m.height=420;
  const g=m.getContext('2d');
  g.fillStyle='#fff'; g.strokeStyle='#fff'; g.lineJoin='round'; g.lineCap='round';
  g.beginPath(); g.ellipse(210,158,112,124,0,0,7); g.fill();            // 머리+머리카락 덩어리
  g.beginPath(); g.moveTo(96,300); g.quadraticCurveTo(60,360,86,420);   // 왼쪽 갈래
  g.lineTo(140,420); g.quadraticCurveTo(120,350,150,296); g.closePath(); g.fill();
  g.beginPath(); g.moveTo(322,300); g.quadraticCurveTo(360,356,332,420);// 오른쪽 갈래
  g.lineTo(276,420); g.quadraticCurveTo(300,350,272,296); g.closePath(); g.fill();
  g.beginPath(); g.moveTo(130,286); g.quadraticCurveTo(210,332,292,286);// 어깨/상체
  g.lineTo(330,420); g.lineTo(90,420); g.closePath(); g.fill();
  g.lineWidth=7;                                                        // 잔머리
  [[118,214,86,268,104,330],[300,206,336,262,318,332],[168,262,150,318,176,372],[252,258,272,314,246,368]]
   .forEach(p=>{ g.beginPath(); g.moveTo(p[0],p[1]); g.quadraticCurveTo(p[2],p[3],p[4],p[5]); g.stroke(); });
  const c=document.createElement('canvas'); c.width=420;c.height=420;
  const q=c.getContext('2d');
  q.drawImage(SUBJ,0,0,420,420);
  q.globalCompositeOperation='destination-in';
  q.drawImage(m,0,0);
  q.globalCompositeOperation='source-over';
  return c;
}

/* ── 시안 원본 encode/build ── */
function encode(frames,W,H,fps,colors,fuzz){
  const enc=GE.GIFEncoder(), delay=Math.round(1000/fps);
  const step=Math.max(1,Math.floor(frames.length/6)), pick=[];
  for(let i=0;i<frames.length;i+=step) pick.push(frames[i]);
  const big=new Uint8ClampedArray(pick.length*W*H*4);
  pick.forEach((f,i)=>big.set(f,i*W*H*4));
  const pal=GE.quantize(big,Math.max(2,colors-1),{format:'rgb565'});
  pal.push([0,0,0]); const TI=pal.length-1;
  let prev=null;
  for(const f of frames){
    let x0=0,y0=0,x1=W-1,y1=H-1;
    if(prev){ x0=W;y0=H;x1=-1;y1=-1;
      for(let y=0;y<H;y++)for(let x=0;x<W;x++){ const o=(y*W+x)*4;
        if(Math.abs(f[o]-prev[o])>fuzz||Math.abs(f[o+1]-prev[o+1])>fuzz||Math.abs(f[o+2]-prev[o+2])>fuzz){
          if(x<x0)x0=x; if(x>x1)x1=x; if(y<y0)y0=y; if(y>y1)y1=y; } }
      if(x1<0){x0=0;y0=0;x1=0;y1=0;} }
    const w=x1-x0+1,h=y1-y0+1;
    const sub=new Uint8ClampedArray(w*h*4);
    for(let y=0;y<h;y++)for(let x=0;x<w;x++){ const s=((y+y0)*W+(x+x0))*4,d=(y*w+x)*4;
      sub[d]=f[s];sub[d+1]=f[s+1];sub[d+2]=f[s+2];sub[d+3]=255; }
    const idx=GE.applyPalette(sub,pal,'rgb565');
    if(prev){ for(let y=0;y<h;y++)for(let x=0;x<w;x++){ const s=((y+y0)*W+(x+x0))*4;
      if(Math.abs(f[s]-prev[s])<=fuzz&&Math.abs(f[s+1]-prev[s+1])<=fuzz&&Math.abs(f[s+2]-prev[s+2])<=fuzz)
        idx[y*w+x]=TI; } }
    enc.writeFrame(idx,w,h,{palette:prev?undefined:pal,first:!prev,x:x0,y:y0,delay,repeat:0,dispose:1,transparent:!!prev,transparentIndex:TI});
    prev=f;
  }
  enc.finish(); return enc.bytes();
}
function subjBox(W,H){ const s=Math.min(H*1.75,W*0.42); return {x:W-s*0.92,y:H-s*0.86,w:s,h:s}; }
function drawSubj(g,W,H,dx,dy,rot){ const b=subjBox(W,H); g.save();
  if(rot){ g.translate(b.x+b.w/2,b.y+b.h); g.rotate(rot); g.translate(-(b.x+b.w/2),-(b.y+b.h)); }
  g.drawImage(CUT,b.x+(dx||0),b.y+(dy||0),b.w,b.h); g.restore(); }
let BRIGHT=false;
function paintBG(g,W,H){ const cols=Math.max(1,Math.round(W/720)),rows=Math.max(1,Math.round(H/150));
  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++) g.drawImage(BG,c*(W/cols),r*(H/rows),W/cols,H/rows);
  if(BRIGHT){ g.save(); g.fillStyle='rgba(255,252,244,0.82)'; g.fillRect(0,0,W,H); g.restore(); } }
function paint(W,H){ const c=document.createElement('canvas'); c.width=W;c.height=H;
  const g=c.getContext('2d',{willReadFrequently:true}); paintBG(g,W,H); return {c,g}; }
function build(fx,W,H,N){
  const {c,g}=paint(W,H); drawSubj(g,W,H,0,0,0);
  const base=g.getImageData(0,0,W,H); const b=subjBox(W,H);
  const api={redrawSubject(gg,dx,dy,rot){ gg.save(); gg.beginPath(); gg.rect(b.x-8,Math.max(0,b.y-8),b.w+16,b.h+16); gg.clip();
    paintBG(gg,W,H); gg.restore(); drawSubj(gg,W,H,dx,dy,rot); }};
  const out=[];
  for(let i=0;i<N;i++){ g.putImageData(base,0,0); g.save(); fx.draw(g,i/N,W,H,api); g.restore();
    out.push(g.getImageData(0,0,W,H).data); }
  return out;
}
let CURW=720,CURH=150;
function restoreBg(g,x,y,w,h){ g.save(); g.beginPath(); g.rect(x,y,w,h); g.clip(); paintBG(g,CURW,CURH); g.restore(); }
function drawSubject(g,dx,dy,sc,rot){ drawSubj(g,CURW,CURH,dx||0,dy||0,rot||0); }
let SUBJECT_BOX=null;

const A={draw:function(g,t,W,H){
  var B=(typeof SUBJECT_BOX!=='undefined'&&SUBJECT_BOX)||{x:W*0.66,y:0,w:W*0.30,h:H};
  var bw=110, x=B.x-bw+(B.w+bw*2)*t, c=x+bw/2, p=(c-B.x)/B.w;
  if(p<=0||p>=1) return;
  var k=Math.sin(Math.PI*p);
  g.save(); g.beginPath(); g.rect(x,B.y-8,bw,B.h+16); g.clip();
  restoreBg(g,x,B.y-8,bw,B.h+16);
  g.shadowColor='rgba(255,246,214,0.95)'; g.shadowBlur=9; g.globalAlpha=0.9*k;
  drawSubject(g,0,0,1,0);
  g.shadowBlur=0; g.globalAlpha=1; drawSubject(g,0,0,1,0);
  g.restore(); }};
const A2={draw:function(g,t,W,H){ SUBJECT_BOX=subjBox(W,H); A.draw(g,t,W,H); SUBJECT_BOX=null; }};
const A3={draw:function(g,t,W,H){ const save=A.draw; SUBJECT_BOX=subjBox(W,H);
  var B=SUBJECT_BOX, bw=110, x=B.x-bw+(B.w+bw*2)*t, c=x+bw/2, p=(c-B.x)/B.w; SUBJECT_BOX=null;
  if(p<=0||p>=1) return; var k=Math.sin(Math.PI*p);
  g.save(); g.beginPath(); g.rect(x,B.y-8,bw,B.h+16); g.clip(); restoreBg(g,x,B.y-8,bw,B.h+16);
  g.shadowColor='rgba(255,246,214,0.95)'; g.shadowBlur=15; g.globalAlpha=0.9*k;
  drawSubject(g,0,0,1,0); g.shadowBlur=0; g.globalAlpha=1; drawSubject(g,0,0,1,0); g.restore(); }};

let _rc=null;
function rimDraw(g,t,W,H,BW,BLUR,ALPHA){
  const b=subjBox(W,H), bw=BW, pad=Math.ceil(BLUR*2.4);
  const span=b.w+bw*2, x=b.x-bw+span*t, c=x+bw/2, p=(c-b.x)/b.w;
  if(p<=0||p>=1) return;
  const k=Math.sin(Math.PI*p);
  const ox=Math.round(x)-pad, oy=-pad, ow=bw+pad*2, oh=H+pad*2;
  if(ox>W||ox+ow<0) return;
  if(!_rc) _rc=document.createElement('canvas');
  if(_rc.width!==ow||_rc.height!==oh){_rc.width=ow;_rc.height=oh;}
  const q=_rc.getContext('2d');
  q.setTransform(1,0,0,1,0,0); q.globalCompositeOperation='source-over'; q.globalAlpha=1;
  q.clearRect(0,0,ow,oh); q.translate(-ox,-oy);
  q.shadowColor='rgba(255,246,214,1)'; q.shadowBlur=BLUR; drawSubj(q,W,H,0,0,0);
  q.shadowBlur=0; q.shadowColor='rgba(0,0,0,0)';
  q.globalCompositeOperation='destination-out'; drawSubj(q,W,H,0,0,0);
  q.setTransform(1,0,0,1,0,0); q.globalCompositeOperation='destination-in';
  const gr=q.createLinearGradient(0,0,ow,0);
  gr.addColorStop(0,'rgba(0,0,0,0)'); gr.addColorStop(.5,'rgba(0,0,0,1)'); gr.addColorStop(1,'rgba(0,0,0,0)');
  q.fillStyle=gr; q.fillRect(0,0,ow,oh);
  g.save(); g.globalCompositeOperation='lighter'; g.globalAlpha=(ALPHA||0.95)*k; g.drawImage(_rc,ox,oy); g.restore();
}
const B60={draw:(g,t,W,H)=>rimDraw(g,t,W,H,60,9,0.95)};
const B110={draw:(g,t,W,H)=>rimDraw(g,t,W,H,110,9,0.95)};
const B160={draw:(g,t,W,H)=>rimDraw(g,t,W,H,160,11,1.0)};
const NONE={draw:()=>{}};
const BOB3={draw:(g,t,W,H,api)=>api.redrawSubject(g,0,Math.round(Math.sin(t*Math.PI*2)*3))};

function stats(frames,W,H,fuzz){
  let tot=0,peak=0,zero=0,per=[];
  for(let i=1;i<frames.length;i++){ const a=frames[i-1],b=frames[i]; let d=0;
    for(let o=0;o<a.length;o+=4) if(Math.abs(b[o]-a[o])>fuzz||Math.abs(b[o+1]-a[o+1])>fuzz||Math.abs(b[o+2]-a[o+2])>fuzz) d++;
    if(d===0)zero++; tot+=d; peak=Math.max(peak,d); per.push(d); }
  let seam=0; { const a=frames[frames.length-1],b=frames[0];
    for(let o=0;o<a.length;o+=4) if(Math.abs(b[o]-a[o])>fuzz||Math.abs(b[o+1]-a[o+1])>fuzz||Math.abs(b[o+2]-a[o+2])>fuzz) seam++; }
  return {avg:tot/(frames.length-1),peak,zero,seam,per};
}
const out=[];
function line(s){ out.push(s); document.getElementById('out').textContent=out.join('\n'); }
function test(name,fx,N){
  let frames; try{ frames=build(fx,720,150,N); }catch(e){ line(name+' ▶ 실행실패 '+e.message); return; }
  const st=stats(frames,720,150,2), px=720*150, r=[];
  for(const [cols,fz] of [[128,2],[255,2]]){
    const by=encode(frames,720,150,N/3,cols,fz);
    r.push(cols+'색='+(by.length/1024).toFixed(0)+'KB'+(by.length<=204800?' OK':' 초과'));
  }
  line(name+' N='+N+' 평균변화='+Math.round(st.avg)+'px('+(100*st.avg/px).toFixed(2)+'%) 피크='+st.peak+'('+(100*st.peak/px).toFixed(2)+'%) 무변화='+st.zero+'/'+(N-1)+' 이음새='+st.seam+'  '+r.join(' | '));
}
function strip(label,fx,ts,amp){
  const w=document.createElement('div');
  w.innerHTML='<div style="color:#8cf;margin:6px 0 2px">'+label+'</div>';
  const {g:bgc}=paint(720,150); drawSubj(bgc,720,150,0,0,0);
  const base=bgc.getImageData(0,0,720,150).data;
  ts.forEach(t=>{ const {c,g}=paint(720,150); drawSubj(g,720,150,0,0,0);
    g.save(); fx.draw(g,t,720,150,null); g.restore();
    c.style.cssText='display:block;margin:1px 0'; w.appendChild(c);
    if(amp){ const d=g.getImageData(0,0,720,150),a=d.data;
      for(let i=0;i<a.length;i+=4){ a[i]=Math.min(255,Math.abs(a[i]-base[i])*6); a[i+1]=Math.min(255,Math.abs(a[i+1]-base[i+1])*6); a[i+2]=Math.min(255,Math.abs(a[i+2]-base[i+2])*6); }
      const c2=document.createElement('canvas'); c2.width=720;c2.height=150;
      c2.getContext('2d').putImageData(d,0,0); c2.style.cssText='display:block;margin:1px 0 8px;outline:1px solid #444'; w.appendChild(c2); } });
  document.getElementById('v').appendChild(w);
}
(async()=>{
  BG=await loadImg(ASSET_BG); SUBJ=await loadImg(ASSET_SUBJ); CUT=makeCut();
  const cg=CUT.getContext('2d'); const cd=cg.getImageData(0,0,420,420).data;
  let a0=0,a255=0,am=0; for(let i=3;i<cd.length;i+=4){ if(cd[i]===0)a0++; else if(cd[i]===255)a255++; else am++; }
  line('누끼 합성 완료 — 투명='+(100*a0/176400).toFixed(1)+'% 불투명='+(100*a255/176400).toFixed(1)+'% 반투명='+(100*am/176400).toFixed(1)+'%');
  test('기준 none          ',NONE,50);
  test('기준 bob3          ',BOB3,50);
  test('A 제안원문(폴백박스)',A,50);
  test('A2 제안원문(실제박스)',A2,50);
  test('A3 제안+blur15     ',A3,50);
  test('B 고침 bw60        ',B60,50);
  test('B 고침 bw110       ',B110,50);
  test('B 고침 bw160/blur11',B160,50);
  test('A 제안원문 N=30    ',A,30);
  test('B 고침 bw110 N=30  ',B110,30);
  test('A 제안원문 N=20    ',A,20);
  BRIGHT=true;
  test('A 밝은배경 N=50    ',A,50);
  test('B 밝은배경 N=50    ',B110,50);
  BRIGHT=false;
  strip('A 제안원문  t=.34/.42/.50/.58/.66  (아래줄=차이 6배)',A,[0.34,0.42,0.50,0.58,0.66],true);
  strip('B 고침 bw110  같은 t',B110,[0.34,0.42,0.50,0.58,0.66],true);
  line('끝');
})();
</script>
