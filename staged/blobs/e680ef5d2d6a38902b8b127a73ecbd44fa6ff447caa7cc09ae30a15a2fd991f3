/* User-created local profile styles. No media or sample names are embedded. */
(function(){
  'use strict';
  var bridge=window.PBKProfilePersonalBridge,unified=window.PBKProfileUnified;
  if(!bridge||!unified)return;
  var busy=false,mounted=false,selected='',rows=[];
