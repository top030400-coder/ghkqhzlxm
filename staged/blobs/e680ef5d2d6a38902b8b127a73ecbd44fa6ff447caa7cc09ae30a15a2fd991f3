  function safeRows(){return bridge.list().filter(function(r){return r&&typeof r.id==='string'&&typeof r.name==='string'&&r.data&&r.data.controls&&r.data.selections;}).slice(0,100);}
  function nameValue(v){var n=String(v||'').trim().slice(0,60);if(!n)throw Error('프리셋 이름을 입력해 주세요.');return n;}
  function find(id){var r=rows.find(function(r){return r.id===id;});if(!r)throw Error('프리셋을 먼저 골라 주세요.');return r;}
  function canEdit(){var s=PBKPilotGifBridge.state();if(busy||s.busy||s.loading)throw Error('현재 작업이 끝난 후 다시 시도해 주세요.');if(!bridge.ready())throw Error('설정을 불러오는 중이에요.');}
  function capture(includeText){
    var data=bridge.capture(includeText);data.selections={};
    ['decorations','rings','backgrounds','motions','typography'].forEach(function(k){data.selections[k]=unified.current(k);});
    data.usesCustomBackground=data.selections.backgrounds==='native:image';
    return data;
  }
  async function save(name,includeText,id){
    canEdit();name=nameValue(name);rows=safeRows();
    if(!id&&rows.length>=100)throw Error('프리셋은 100개까지 저장할 수 있어요. 사용하지 않는 항목을 삭제해 주세요.');
    var row={id:id||('profile-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,8)),name:name,data:capture(includeText),updatedAt:Date.now()};
    var next=rows.slice();if(id)next[next.findIndex(function(r){return r.id===find(id).id;})]=row;else next.push(row);
    busy=true;sync();try{await bridge.write(next);rows=next;selected=row.id;message('저장했어요. 다음에 다시 적용할 수 있어요.');return row.id;}finally{busy=false;render();}
  }
