  async function remove(id){canEdit();rows=safeRows();find(id);var next=rows.filter(function(r){return r.id!==id;});busy=true;sync();try{await bridge.write(next);rows=next;selected='';message('프리셋을 삭제했어요. 현재 편집 내용은 유지돼요.');}finally{busy=false;render();}}
  async function apply(id){
