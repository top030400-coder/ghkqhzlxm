    var title=document.createElement('b');title.textContent='새 디자인 · 분류별 1종';panel.appendChild(title);
    var note=document.createElement('p');note.style.cssText='font-size:11px;line-height:1.55;margin:5px 0 8px';note.textContent='사진·영상은 틀 안쪽에 맞춰지고 장식은 그대로 남아요. 이름·자막·영상 움직임은 기존 설정으로 조절하세요.';panel.appendChild(note);
    data.forEach(function(x){var b=document.createElement('button');b.type='button';b.dataset.pilotGif=x.id;b.style.cssText='display:block;width:100%;text-align:left;margin:4px 0;padding:7px 8px';b.textContent=x.category+' · '+x.theme;b.onclick=function(){apply(x.id).catch(function(e){alert(e.message);});};panel.appendChild(b);});
