(() => {
  'use strict';
  const base = new URL('.', document.currentScript.src);
  const assets = window.PBK_PILOT_SIGNATURE_ASSETS || [];
  const bytes = new Map();
  const pending = new Map();
  let busy = false;
  const byId = new Map(assets.map(a => [a.id, a]));
  const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

  function loadBytes(asset) {
    if (bytes.has(asset.id)) return Promise.resolve(bytes.get(asset.id));
    if (pending.has(asset.id)) return pending.get(asset.id);
    const promise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = new URL(asset.dataFile, base).href;
      script.onload = () => bytes.has(asset.id) ? resolve(bytes.get(asset.id)) : reject(new Error('이미지 파일 내용을 확인하지 못했어요.'));
      script.onerror = () => reject(new Error('시안 파일을 읽지 못했어요. 검수본 폴더 전체를 다시 확인해 주세요.'));
      document.head.appendChild(script);
    }).catch(error => { pending.delete(asset.id); throw error; });
    pending.set(asset.id, promise);
    return promise;
  }

  function pngFile(encoded, name) {
    const raw = atob(encoded);
    const data = new Uint8Array(raw.length);
    for (let i = 0; i < raw.length; i++) data[i] = raw.charCodeAt(i);
    return new File([data], name, { type: 'image/png' });
  }

  function status(kind, text, error = false) {
    const note = document.getElementById('pilotSigStatus-' + kind);
    if (note) { note.textContent = text; note.classList.toggle('error', error); }
  }

  async function apply(id) {
    const asset = byId.get(id);
    if (!asset) throw new Error('등록되지 않은 검수 시안이에요.');
    if (busy) throw new Error('앞의 시안을 불러오는 중이에요. 잠시 뒤 다시 눌러 주세요.');
    const input = document.getElementById(asset.kind === 'background' ? 'sigBgFile' : 'sigPropFile');
    if (!input) throw new Error('시그풍 화면이 아직 준비되지 않았어요.');
    busy = true;
    document.querySelectorAll('.pilot-sig-card').forEach(button => button.disabled = true);
    status(asset.kind, asset.label + ' 불러오는 중…');
    try {
      const encoded = await loadBytes(asset);
      const file = pngFile(encoded, '검수_' + asset.id + '_' + asset.label + '.png');
      // The native upload commits the matching border setting in the same undo step.
      if (asset.kind === 'background') file.pbkOriginalBorder = true;
      const transfer = new DataTransfer();
      transfer.items.add(file);
      input.files = transfer.files;
      input.dispatchEvent(new Event('change', { bubbles: true }));
      const started = performance.now();
      while (input.files.length) {
        if (performance.now() - started > 20000) throw new Error('불러오기가 끝나지 않았어요. 시그풍 화면의 오류 안내를 확인해 주세요.');
        await delay(40);
      }
      const nativeStatus = document.getElementById(asset.kind === 'background' ? 'sigBgUploadName' : 'sigPropUploadStatus')?.textContent || '';
      if (/실패/.test(nativeStatus)) throw new Error(nativeStatus);
      document.querySelectorAll('.pilot-sig-card[data-kind="' + asset.kind + '"]').forEach(button => {
        button.classList.toggle('selected', button.dataset.assetId === id);
        button.setAttribute('aria-pressed', String(button.dataset.assetId === id));
      });
      status(asset.kind, asset.label + (asset.kind === 'background' ? ' 적용됨 · 캐릭터와 문구는 그대로 유지돼요.' : ' 추가됨 · 선택한 소품의 위치·크기·회전·색을 아래에서 바꿀 수 있어요.'));
      return { id, kind: asset.kind, sourceSha256: asset.sha256 };
    } catch (error) {
      status(asset.kind, error.message || String(error), true);
      throw error;
    } finally {
      busy = false;
      document.querySelectorAll('.pilot-sig-card').forEach(button => button.disabled = false);
    }
  }

  function gallery(kind, target) {
    if (document.getElementById('pilotSig-' + kind)) return;
    const list = assets.filter(a => a.kind === kind);
    const details = document.createElement('details');
    details.className = 'pilot-sig';
    details.id = 'pilotSig-' + kind;
    details.open = kind === 'background';
    const title = document.createElement('summary');
    title.textContent = '검수 시안 · ' + (kind === 'background' ? '배경 5종' : '소품 18종');
    details.appendChild(title);
    const help = document.createElement('p');
    help.className = 'pilot-sig-help';
    help.textContent = kind === 'background'
      ? '분류마다 한 가지씩 추가했어요. 카드 내부는 채우고 상단 84px와 카드 밖은 투명하게 유지해요. 원본에 포함된 테두리를 사용하므로 추가 테두리는 꺼져요.'
      : '각 분류의 시안을 하나씩 넣었어요. 원하는 그림을 누르면 독립 소품으로 추가돼요. 레이어에서 선택·삭제하고 기존 지우개와 색 변경도 사용할 수 있어요.';
    details.appendChild(help);
    const grid = document.createElement('div');
    grid.className = 'pilot-sig-grid ' + kind;
    list.forEach(asset => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'pilot-sig-card';
      button.dataset.assetId = asset.id;
      button.dataset.kind = kind;
      button.setAttribute('aria-pressed', 'false');
      button.title = asset.category + ' · ' + asset.label;
      const visual = document.createElement('span');
      visual.className = 'pilot-sig-image';
      const img = new Image();
      img.src = new URL(asset.file, base).href;
      img.alt = '';
      img.loading = 'lazy';
      visual.appendChild(img);
      button.appendChild(visual);
      const category = document.createElement('small');
      category.textContent = asset.shortCategory;
      button.appendChild(category);
      const label = document.createElement('span');
      label.textContent = asset.label;
      button.appendChild(label);
      button.addEventListener('click', () => { apply(asset.id).catch(() => {}); });
      grid.appendChild(button);
    });
    details.appendChild(grid);
    const note = document.createElement('p');
    note.id = 'pilotSigStatus-' + kind;
    note.className = 'pilot-sig-status';
    note.setAttribute('role', 'status');
    note.textContent = kind === 'background' ? '배경 시안을 눌러 적용하세요.' : '소품 시안을 눌러 추가하세요.';
    details.appendChild(note);
    const heading = target.querySelector('.sig-section-title');
    if (heading) heading.after(details); else target.prepend(details);
  }

  function mount() {
    const bg = document.getElementById('sigBgFile')?.closest('.sig-section');
    const props = document.getElementById('sigPropFile')?.closest('.sig-section');
    if (!bg || !props) return false;
    gallery('background', bg); gallery('prop', props);
    return true;
  }
  window.PBKPilotSignature = {
    assets: assets.map(({ id, category, label, kind, sha256, file }) => ({ id, category, label, kind, sha256, file })),
    register(id, encoded) { if (byId.has(id)) bytes.set(id, encoded); },
    apply,
    mount
  };
  const css = document.createElement('link');
  css.rel = 'stylesheet'; css.href = new URL('pilot_signature.css', base).href;
  document.head.appendChild(css);
  if (!mount()) {
    const observer = new MutationObserver(() => { if (mount()) observer.disconnect(); });
    observer.observe(document.documentElement, { childList: true, subtree: true });
  }
})();
