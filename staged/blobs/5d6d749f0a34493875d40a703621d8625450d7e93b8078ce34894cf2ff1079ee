#pilotSig-background,#pilotSig-prop,#fullSig-background,#fullSig-prop { display:none!important; }
.sig-native-controls { display:grid;gap:6px;margin:7px 0 9px; }
.sig-native-controls input,.sig-native-controls select { width:100%;min-width:0;box-sizing:border-box;font:inherit;font-size:11px;padding:7px 8px;border:1px solid #dcd5e6;border-radius:7px;background:#fff;color:#3f354c; }
.sig-native-pager { display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:#776c83; }
.sig-native-pager button { border:1px solid #ddd4e9;background:#fff;border-radius:6px;padding:4px 9px;color:#514367;cursor:pointer; }
.sig-native-pager button:disabled { opacity:.35;cursor:default; }
#sigNativeLibraryStatus { margin:5px 0 0;font-size:10px;line-height:1.5; }
#sigNativeLibraryStatus.error { color:#aa3454; }
#sigImagePropGrid .sig-image-prop img { object-fit:contain; }
#sigImagePropGrid { min-height:90px; }
#sigView .sig-preset[data-asset-id] span { position:static;display:block;max-width:none;margin:0;border-radius:0;line-height:1.3;box-shadow:none; }
