  [a,b].forEach(function(v,i){var h=v.getContext('2d');h.fillStyle=i?'#fbe5f3':'#c6e1ee';h.fillRect(0,0,W,W);h.fillStyle=i?'#a96389':'#456889';h.font='bold 30px sans-serif';h.textAlign='center';h.fillText(i?'이름':'사진',W/2,W*.55);});
  if(kind==='motions')api.drawTransition(g,W,a,b,.5,{id:row.id,colorA:'#ef9dbd',colorB:'#b9c7ef',clipRadius:W/2});
